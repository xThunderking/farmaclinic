[Unit]
Description=FarmaClinic API (coexistence profile)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=sistemas
Group=sistemas
WorkingDirectory=/home/sistemas/farmaclinic/backend
Environment=NODE_ENV=production
EnvironmentFile=/home/sistemas/farmaclinic/backend/.env.internal
ExecStart=/home/sistemas/.nvm/versions/node/v20.20.2/bin/node src/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
